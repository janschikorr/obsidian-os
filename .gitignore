.DS_Store
*.tmp
.claude/settings.local.json

# Claudian app runtime state (session cache, device info) - machine-local,
# regenerated per device, never part of the Personal OS itself.
.claudian/

# This repo tracks the Personal OS "code" (rules, skills, scripts, root
# docs), not the data living inside it - see 10_Reviews/decisions/
# vault-git-scope.md. Everything below is personal content.
#
# Per folder: ignore all files, but keep the directory tree itself and any
# .gitkeep - so the empty structure ships with the repo (visible on a fresh
# clone) while the actual notes never do. `folder/**` alone would also hide
# subdirectories from git entirely (nothing to re-include a file inside an
# ignored dir), hence the two negations.
00_Inbox/**
!00_Inbox/**/
!00_Inbox/**/.gitkeep
01_Me/**
!01_Me/**/
!01_Me/**/.gitkeep
02_Visions/**
!02_Visions/**/
!02_Visions/**/.gitkeep
03_Goals/**
!03_Goals/**/
!03_Goals/**/.gitkeep
04_Projects/**
!04_Projects/**/
!04_Projects/**/.gitkeep
05_Tasks/**
!05_Tasks/**/
!05_Tasks/**/.gitkeep
06_Events/**
!06_Events/**/
!06_Events/**/.gitkeep
# Exception: unlike the other content folders, 07_Knowledge/'s topic
# subfolders are not part of the vault's structural skeleton - only the
# top-level folder ships with the repo, its subfolders stay purely local.
07_Knowledge/**
!07_Knowledge/.gitkeep
08_People/**
!08_People/**/
!08_People/**/.gitkeep
10_Reviews/**
!10_Reviews/**/
!10_Reviews/**/.gitkeep
11_Work/**
!11_Work/**/
!11_Work/**/.gitkeep

# Obsidian machine-local UI state - not portable between devices.
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Plugins: the custom plain-* plugins are standalone git repos with their
# own history/remote (see 10_Reviews/decisions/custom-*-plugin.md), never
# read/embed from the vault repo. Third-party plugins/themes are installed
# via BRAT or the community store and reproducible from
# community-plugins.json - none of it is vault content.
.obsidian/plugins/
